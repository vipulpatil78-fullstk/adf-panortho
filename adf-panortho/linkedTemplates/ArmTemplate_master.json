{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-panortho"
		},
		"AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1018-123501-tgl1e0t7"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azure-sql-panortho-db-server.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azure_sql_panortho_db"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "root-panortho"
		},
		"kv_panortho_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://keyvault-panortho.vault.azure.net/"
		},
		"ls_adlspanortho_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlspanortho.dfs.core.windows.net/"
		},
		"ls_pg_panortho_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-bitter-art-ao2h5unz-pooler.c-2.ap-southeast-1.aws.neon.tech"
		},
		"ls_pg_panortho_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "panortho_db"
		},
		"ls_pg_panortho_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-panortho_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"kv_panortho_properties_typeProperties_baseUrl": {
						"value": "[parameters('kv_panortho_properties_typeProperties_baseUrl')]"
					},
					"ls_adlspanortho_properties_typeProperties_url": {
						"value": "[parameters('ls_adlspanortho_properties_typeProperties_url')]"
					},
					"AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"ls_pg_panortho_properties_typeProperties_server": {
						"value": "[parameters('ls_pg_panortho_properties_typeProperties_server')]"
					},
					"ls_pg_panortho_properties_typeProperties_database": {
						"value": "[parameters('ls_pg_panortho_properties_typeProperties_database')]"
					},
					"ls_pg_panortho_properties_typeProperties_username": {
						"value": "[parameters('ls_pg_panortho_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}